# =============================================================================
# NewsLens-AI — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it is in .gitignore.
# =============================================================================

# --- MySQL (system of record) ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=newslens
MYSQL_PASSWORD=newslens_pass
MYSQL_DB=newslens
MYSQL_ROOT_PASSWORD=newslens_root

# --- Qdrant (vector store) ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
# QDRANT_API_KEY=          # Set for Qdrant Cloud; leave blank for local
QDRANT_COLLECTION_NAME=article_chunks

# --- MinIO / Object Storage ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_SECURE=false           # Set to true when using HTTPS (production)
MINIO_BUCKET_PAGES=newslens-pages
MINIO_BUCKET_ORIGINALS=newslens-originals

# --- Redis (cache + Celery broker) ---
REDIS_URL=redis://localhost:6379/0

# --- Ollama (local LLM / VLM) ---
OLLAMA_BASE_URL=http://localhost:11434

# --- API Keys: Hosted Providers (optional — leave blank to use local only) ---
# GROQ_API_KEY=gsk_...
# GEMINI_API_KEY=...
# GOOGLE_API_KEY=...
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# GCP_SERVICE_ACCOUNT_KEY=./service-account.json
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# VOYAGE_API_KEY=...

# --- Application ---
APP_SECRET_KEY=change-me-in-production-use-a-random-64-char-string
APP_DEBUG=true
APP_LOG_LEVEL=INFO
APP_WORKERS=1                # Uvicorn workers; use cpu_count*2+1 in production

# --- Model Config ---
MODEL_CONFIG_PATH=../model_config.yaml   # Relative to backend/ dir; adjust as needed
