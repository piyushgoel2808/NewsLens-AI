# =============================================================================
# NewsLens-AI — Environment Variables
# =============================================================================
# Copy this file to .env and customize for your environment.
# NEVER commit your real .env file to git — it is ignored in .gitignore.
# =============================================================================

# --- Application Core ---
APP_NAME=NewsLens-AI
APP_DEBUG=true                # Set to false in production
APP_LOG_LEVEL=INFO            # DEBUG, INFO, WARNING, ERROR
APP_SECRET_KEY=change-me-in-production-use-a-random-64-char-string
APP_WORKERS=1                 # Uvicorn workers; use cpu_count*2+1 in production
FRONTEND_PORT=3000            # Port for Docker production frontend (default: 3000)
TESTING=false

# --- CORS Settings (Frontend origins permitted to access backend) ---
# Comma-separated list of allowed origins. In dev (APP_DEBUG=true), wildcard is allowed.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:5174

# --- Model Config Path ---
# Path to model_config.yaml relative to current working directory or absolute
MODEL_CONFIG_PATH=model_config.yaml

# --- MySQL 8 (System of Record) ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=newslens
MYSQL_PASSWORD=newslens_pass
MYSQL_DB=newslens
MYSQL_ROOT_PASSWORD=newslens_root

# --- Qdrant (Vector DB) ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
# QDRANT_API_KEY=             # Set for Qdrant Cloud; leave blank for local
QDRANT_COLLECTION_NAME=article_chunks

# --- MinIO (S3-Compatible Object Storage) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_SECURE=false            # Set to true when using HTTPS in production
MINIO_BUCKET_PAGES=newslens-pages
MINIO_BUCKET_ORIGINALS=newslens-originals

# --- Redis & Celery (Cache, Rate Limiting & Async Tasks) ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- Ollama (Local LLM / VLM) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# --- Google AI Studio / Gemini Cloud (Recommended Cloud Provider: VLM Vision, Query Planning, Answering) ---
# GEMINI_API_KEY=AIzaSy...
# GOOGLE_API_KEY=AIzaSy...

# --- Hosted LLM Providers (Optional Alternative Cloud Providers) ---
# GROQ_API_KEY=gsk_...
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# --- OpenRouter (Optional: Multi-Provider Gateway) ---
# OPENROUTER_API_KEYS=sk-or-v1-...
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- NVIDIA NIM API (Optional: Accelerated Inference) ---
# NVIDIA_API_KEY=nvapi-...
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# --- Hugging Face (Optional: Token for gated models) ---
# HF_TOKEN=hf_...
# HUGGINGFACE_TOKEN=hf_...

# --- Live Web / News Search Providers (Optional) ---
# NEWSDATA_API_KEY=pub_...    # Primary news intelligence search engine (NewsData.io)
# SERPER_API_KEY=...          # Google Search API (serper.dev)
# TAVILY_API_KEY=tvly-...     # Tavily AI Search (tavily.com)
